<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ecommerce.mapper.HomeMapper">
  <select id="findBanners" resultType="com.example.ecommerce.model.Banner">
    select * from banner
    <where><if test="keyword != null and keyword != ''">title like concat('%',#{keyword},'%')</if></where>
    order by sort_order,id
  </select>
  <insert id="insertBanner" useGeneratedKeys="true" keyProperty="id">insert into banner(title,image_url,link_url,sort_order) values(#{title},#{imageUrl},#{linkUrl},#{sortOrder})</insert>
  <update id="updateBanner">update banner set title=#{title},image_url=#{imageUrl},link_url=#{linkUrl},sort_order=#{sortOrder} where id=#{id}</update>
  <delete id="deleteBanner">delete from banner where id=#{id}</delete>
  <select id="findHotProducts" resultType="com.example.ecommerce.model.Product">select * from product where is_on_sale=1 order by sales desc,id desc limit 6</select>
  <select id="findNewProducts" resultType="com.example.ecommerce.model.Product">select * from product where is_on_sale=1 order by id desc limit 6</select>
</mapper>
