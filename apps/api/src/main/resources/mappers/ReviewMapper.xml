<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ecommerce.mapper.ReviewMapper">
  <select id="findByProductId" resultType="com.example.ecommerce.model.ProductReview">select * from product_review where product_id=#{productId} order by created_at desc,id desc</select>
  <select id="findAll" resultType="com.example.ecommerce.model.ProductReview">select * from product_review order by created_at desc,id desc</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into product_review(user_id,product_id,rating,content,image_url,created_at) values(#{userId},#{productId},#{rating},#{content},#{imageUrl},#{createdAt})</insert>
  <delete id="delete">delete from product_review where id=#{id}</delete>
</mapper>
