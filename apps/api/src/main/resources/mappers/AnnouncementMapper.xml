<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ecommerce.mapper.AnnouncementMapper">
  <select id="findAll" resultType="com.example.ecommerce.model.Announcement">select * from announcement order by created_at desc,id desc</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into announcement(title,content,created_at) values(#{title},#{content},#{createdAt})</insert>
  <update id="update">update announcement set title=#{title},content=#{content} where id=#{id}</update>
  <delete id="delete">delete from announcement where id=#{id}</delete>
</mapper>
